# 图像/文本接口（OpenAI 兼容；本仓库实测用的是 CogFoundry 路由）
IMG_BASE_URL=https://router.cogfoundry.ai/api/v1
IMG_MODEL=openai/gpt-image-2
IMG_API_KEY=your-api-key-here

# 直连该域名被 Cloudflare 拦（error code:1034 / 1010）时填本地代理；直连正常就留空
IMG_PROXY=

# 文本/看图模型（run_13rows.py 的 --text-model 默认值同此口径）
TEXT_MODEL=google/gemini-2.5-pro
